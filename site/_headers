# Headers for the files served straight from this directory. The Worker's own paths ignore it.
#
# The two installers are sent as text so that a browser shows them instead of downloading
# them: they are meant to be read before anybody pipes them into a shell.

/install.sh
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff

/install.ps1
  Content-Type: text/plain; charset=utf-8
  X-Content-Type-Options: nosniff
