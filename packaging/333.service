# Running the node in the background, on anything with systemd.
#
# `333 start` writes this unit to ~/.config/systemd/user/ with the flags you give it,
# keeps the node running after you log out and starts it at boot, and adds an hourly
# check. `333 stop` stops it and keeps it stopped, and `333 status` says whether it
# runs. A copy of this file enabled by hand also runs the node, but `333 status` then
# reports it as running in a terminal and `333 stop` cannot keep it stopped.
#
# A user service rather than a system one, because a node lives in one person's home
# directory and the client refuses to start on a directory other people can enter.
# Running it as root would mean either loosening that or keeping the node somewhere it
# does not belong.
#
#   systemctl --user status 333.service   what it is doing
#   journalctl --user -u 333 -f           what it is saying
#
# `status` wants the .service: given a bare number, systemctl reads it as a process id.

[Unit]
Description=333
Documentation=https://the333.dev
After=network-online.target
Wants=network-online.target

[Service]
# --plain because there is nobody at a terminal. The screen is for when there is.
ExecStart=%h/.local/bin/333 serve --plain
# Restarting after 333 seconds rather than at once. A node that cannot start comes
# back five and a half minutes later instead of a thousand times a minute, and an
# epoch is long enough that nothing is lost by waiting.
Restart=always
RestartSec=333
NoNewPrivileges=yes
# No PrivateTmp and no ProtectSystem. In a user unit either one runs the node inside a
# namespace of its own, where / belongs to nobody, and a node that checks that its
# directory is private all the way up finds that it is not and refuses to start.
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=default.target
