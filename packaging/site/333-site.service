# the333.dev: the meeting point and the pages, as a user service of the system user
# `the333`, listening on 127.0.0.1:8080 for Caddy.
#
# Once, as root (the user, its lingering manager, and the directory the observer writes):
#
#   useradd --system --create-home --home-dir /home/the333 --shell /usr/sbin/nologin the333
#   loginctl enable-linger the333
#   install -d -o ubuntu -g ubuntu -m 0755 /var/lib/333-observation
#
# Then as the333 (sudo -iu the333 does not work with a nologin shell; use
#   sudo -u the333 -H env XDG_RUNTIME_DIR=/run/user/$(id -u the333) <command>):
#
#   curl --proto '=https' -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
#   git clone https://github.com/needmoretruth/333 ~/repo
#   cd ~/repo && ~/.cargo/bin/cargo build --release --locked -p n333-site
#   ./target/release/333-site deploy --repo ~/repo --releases ~/releases --unit 333-site.service
#       (the first deploy builds again under the lock, makes ~/releases/current, and
#        fails at the restart because the unit is not installed yet; that is expected)
#   mkdir -p ~/.config/systemd/user
#   cp ~/repo/packaging/site/333-site.service ~/repo/packaging/site/333-site-deploy.* ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now 333-site.service 333-site-deploy.timer
#
#   systemctl --user status 333-site.service   what it is doing
#   journalctl --user -u 333-site -f           what it is saying (never a visitor's address)
#
# The board is kept in ~/state/board.json (0600). The version pages show is the short
# commit `deploy` writes into each release as VERSION.

[Unit]
Description=the333.dev meeting point and pages
Documentation=https://the333.dev
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/releases/current/333-site serve --site %h/releases/current/site --state %h/state --observation /var/lib/333-observation/network.json --version-file %h/releases/current/VERSION
Restart=always
RestartSec=2
UMask=0077
# Hardening that works in a user manager without namespaces. ProtectSystem, PrivateTmp
# and the like need an unprivileged user namespace in a user unit, which Ubuntu's
# AppArmor refuses by default; the unit would then not start at all.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# It speaks TCP to Caddy and nothing else.
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=default.target
