### What a typed order that could not be read is told. The order words themselves
### (ping, join, say, tor on, quit, ...) are the command line's and are never here.

orders-nothing-typed = nothing typed
orders-unknown = there is no `{ $word }` here. { $words }
orders-wants = that wants { $what } after it

orders-wants-address = an address
orders-wants-invitation = an invitation
orders-wants-signal = which of the 333
orders-wants-on-or-off = on or off
orders-wants-bridge-line = a bridge line
orders-wants-program = a program name or path
orders-wants-status-word = nothing, --all, --sources or --json
