### `333 serve --tor`: an onion address, for a node that is hiding.

serve-onion-launching = launching the onion service

serve-onion-raising = the unseen address. this can take minutes.
    .keyword = raising

serve-onion-not-reachable = not reachable after { $seconds } s

serve-onion-waiting = waiting for the service to be reachable

serve-onion-unseen = { $address }
    .keyword = unseen

serve-onion-invite = { $invitation }
    .keyword = invite

serve-onion-accepting = accepting a peer

serve-onion-not-built = this client was built without Tor, so it cannot publish an onion
    address
