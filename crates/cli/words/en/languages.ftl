### `333 languages`, and what each language calls itself.

# The language's name in itself. Shown in every language's list as it is written here.
languages-name = English

languages-one = { $tag }  { $name }  { $percent }% of the messages English has
    .keyword = language

languages-speaking = { $tag }. `333 language <TAG>` saves another for every command.
    .keyword = speaking

languages-saved = { $tag }, for every command from now on. A node already running
    keeps its language until `333 restart`.
    .keyword = language

languages-english = English, for every command from now on. A node already running
    keeps its language until `333 restart`.
    .keyword = language

languages-unknown = there are no words for { $tag } here. `333 language` lists the
    languages there are.

languages-saving = saving the language in { $path }
