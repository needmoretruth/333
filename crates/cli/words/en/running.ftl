### Whether this node is running, and how: the first line of `333` and `333 status`.

running-background-since = in the background since { $since }, { $ago } ago
    .keyword = running

running-background = in the background
    .keyword = running

running-terminal-since = in a terminal since { $since }, { $ago } ago
    .keyword = running

running-terminal = in a terminal
    .keyword = running

running-not = no. `333 start` runs it in the background.
    .keyword = running
