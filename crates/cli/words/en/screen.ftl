### The screen: what it says in the vigil's pane about what was typed into it.

screen-asked = { $typed }
    .keyword = asked
screen-unheard = nothing is carrying orders out any more
    .keyword = unheard
screen-unread = { $why }
    .keyword = unread
screen-refused = { $why }
    .keyword = refused

screen-at = { $hours }:{ $minutes }:{ $seconds }
