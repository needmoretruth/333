### `333` with no command: how this node is, and what to type next.

overview-no-node = none yet in { $home }
    .keyword = node

overview-name = { $name }
    .keyword = name

overview-next-new = `333 join <invitation>` joins with an invitation from someone who
    runs 333. `333 begin` starts on your own.
    .keyword = next

overview-next-stopped = `333 start` runs it in the background. `333 run` runs it in
    this terminal.
    .keyword = next

overview-next-running = `333 status` shows how it is doing. `333 stop` stops it.
    .keyword = next
