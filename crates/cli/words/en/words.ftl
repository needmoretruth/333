### What choosing the words and the base says, once, at the start.

words-broken = part of { $file } could not be read (line { $line }). What that part says is
    said in English.
    .keyword = words

words-unreadable = { $file } could not be read: { $why }. What it says is said in English.
    .keyword = words

words-no-catalog = there are no words for { $tag } here, so everything is said in English.
    `333 language` lists the languages there are.
    .keyword = language

words-counting-in-twelve = in twelve. { $ten } is ten, { $eleven } is eleven, and 10 is twelve.
    .keyword = counting

words-count-in-unknown = in ten. THE333_COUNT_IN says "{ $value }", which is not ten, twelve or
    twelve-ascii.
    .keyword = counting
