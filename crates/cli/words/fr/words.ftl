### What choosing the words and the base says, once, at the start.

words-broken = une partie de { $file } est illisible (ligne { $line }). Ce qu’elle dit
    est dit en anglais.
    .keyword = mots

words-unreadable = { $file } est illisible : { $why }. Ce qu’il dit est dit en anglais.
    .keyword = mots

words-no-catalog = il n’y a pas de mots pour { $tag } ici, tout est donc dit en anglais.
    `333 language` liste les langues disponibles.
    .keyword = langue

words-counting-in-twelve = en douze. { $ten } vaut dix, { $eleven } vaut onze, et 10 vaut douze.
    .keyword = compte

words-count-in-unknown = en dix. THE333_COUNT_IN dit « { $value } », qui n’est ni ten, ni
    twelve, ni twelve-ascii.
    .keyword = compte
