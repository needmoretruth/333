### `333 languages`, and what each language calls itself.

# The language's name in itself. Shown in every language's list as it is written here.
languages-name = Français

languages-one = { $tag }  { $name }  { $percent } % traduit
    .keyword = langue

languages-speaking = { $tag }. `333 language <TAG>` en garde une autre pour toutes les commandes.
    .keyword = parle

languages-saved = { $tag }, pour toutes les commandes désormais. Un nœud déjà en marche
    garde sa langue jusqu’à `333 restart`.
    .keyword = langue

languages-english = anglais, pour toutes les commandes désormais. Un nœud déjà en marche
    garde sa langue jusqu’à `333 restart`.
    .keyword = langue

languages-unknown = il n’y a pas de mots pour { $tag } ici. `333 language` liste les
    langues disponibles.

languages-saving = enregistrement de la langue dans { $path }
