### What the network library says when the meeting point cannot be reached.

failed-net-unreachable = 无法到达汇合点：{ $why }
failed-net-silent = 汇合点接受了连接，但 { $seconds } 秒内没有应答
failed-net-broke-off = 汇合点的回应中断了：{ $why }
failed-net-not-yet = 汇合点暂时不接受这个地址的下一条声明：{ $said }
failed-net-full-for-today = 汇合点今天已收满声明：{ $said }
failed-net-refused-because = 汇合点回应 { $status }：{ $said }
failed-net-refused = 汇合点回应 { $status }
failed-net-statement-too-long = { $got } 字节的声明超过了公告板上限 { $longest }
failed-net-not-an-address = 汇合点没有回应地址
