### The screen's two bottom lines. Each line has a wide form and a narrow one,
### for a terminal under 62 columns.

screen-draw-bottom-never-answered-wide = 还没有人应答过这个节点
screen-draw-bottom-never-answered = 从未有人应答
screen-draw-bottom-alive-wide = 有人在应答
screen-draw-bottom-alive = 有人应答
screen-draw-bottom-waiting-wide = 下结论所需的 { $needed } 个纪元里，已有 { $silent } 个无人应答
screen-draw-bottom-waiting = { $needed } 个中 { $silent } 个无应答
screen-draw-bottom-ended = 自纪元 { $since } 起无人应答。还有{ $years ->
       *[other] { $years } 年
    }{ $days ->
       *[other] { $days } 天
    }就消失
screen-draw-bottom-ended-and-gone = 自纪元 { $since } 起无人应答，最后的年份也已用尽

screen-draw-bottom-say-which = 说 333 中的哪一个？
screen-draw-bottom-say-keys = 回车说出 · Esc 什么都不说

screen-draw-bottom-leave-wide = 停止节点
screen-draw-bottom-leave = 停止
screen-draw-bottom-say-wide = 说 333 中的一个
screen-draw-bottom-say = 说
screen-draw-bottom-more-wide = 其他一切
screen-draw-bottom-more = 更多
screen-draw-bottom-has-the-file = 文件在这里
screen-draw-bottom-not-given = 这个节点还没拿到文件
screen-draw-bottom-keys-wide = 所有按键
screen-draw-bottom-keys = 按键
