### What clap says around the words of each command's help.

help-frame-usage = 使い方
help-frame-commands = コマンド
help-frame-arguments = 引数
help-frame-options = オプション
help-frame-default = 既定値
help-frame-alias = { $aliases ->
       *[other] 別名
    }

help-frame-advanced = 上級

help-frame-more-commands = その他のコマンド
