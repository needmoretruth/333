### `333 languages`, and what each language calls itself.

# The language's name in itself. Shown in every language's list as it is written here.
languages-name = 日本語

languages-one = { $tag }  { $name }  翻訳 { $percent }%
    .keyword = 言語

languages-speaking = { $tag }。`333 language <TAG>` で全コマンド用に別の言語を保存します。
    .keyword = 使用中

languages-saved = { $tag }。これから全コマンドで使います。すでに動いている
    ノードは `333 restart` まで元の言語のままです。
    .keyword = 言語

languages-english = 英語。これから全コマンドで使います。すでに動いている
    ノードは `333 restart` まで元の言語のままです。
    .keyword = 言語

languages-unknown = ここには { $tag } の言葉がありません。`333 language` で
    使える言語を一覧できます。

languages-saving = 言語を { $path } に保存中
