### `333 run`: trading with the other nodes once an epoch, and asking whoever was drawn.

hours-asking-failed-gathering = sammle, was dieser Knoten weitergeben könnte: { $why }
    .keyword = Fehler

hours-asking-quiet = { $address }: { $why }
    .keyword = still

hours-asking-unended = der Tausch wurde in { $time } dieser Epoche nicht fertig, und der
    Rest der Stunden wartet nicht darauf
    .keyword = offen

hours-asking-reading-address = lese die Adresse eines Gegenübers
hours-asking-exchanging-heartbeats = tausche Herzschläge
hours-asking-trading = tausche Aussagen
hours-asking-putting = stelle die Frage
hours-asking-sealing-presenting = versiegle, was dieser Knoten sagen wollte
hours-asking-saying-what-for = sage, wofür dieser Knoten gekommen ist
hours-asking-sealing-silence = versiegle, was nicht geschah

hours-asking-no-answer = keine Antwort
hours-asking-did-not-answer = { $address } hat nicht geantwortet
hours-asking-did-not-finish = { $address } hat den Herzschlag nicht beendet
hours-asking-neither = { $address } hat weder gefragt noch aufgelegt
hours-asking-within = { $what } in den { $seconds } s, die das Fenster erlaubt
hours-asking-nothing-within = nichts in den { $seconds } s, die das Fenster erlaubt

hours-asking-going = niemand draußen kann eine Verbindung zu diesem Knoten öffnen, also
    geht er zu den { $drawn } von uns, die ausgelost wurden, ihn in dieser
    Epoche zu fragen. Die Losung folgt aus der Epoche und den Schlüsseln,
    also weiß dieser Knoten, wer sie sind, ohne dass man es ihm sagt.
    .keyword = geht

hours-asking-unknown-drawn-by = ausgelost, gefragt zu werden von einem von uns, dessen Ort
    niemand genannt hat
    .keyword = unbek.

hours-asking-unasked = Epoche { $epoch }: { $why }
    .keyword = ungefr.

hours-asking-drawn = Epoche { $epoch } — { $asked } von uns zu fragen. Niemand hat das
    gewählt: die Namen folgen aus der Epoche und den Schlüsseln, auf
    jedem Rechner gleich.
    .keyword = gelost

hours-asking-unknown-drawn-to-ask = ausgelost, einen von uns zu fragen, dessen Ort niemand genannt hat
    .keyword = unbek.

hours-asking-unheard = Epoche { $epoch }: { $why }
    .keyword = ungehört

hours-asking-witness = Epoche { $epoch } beantwortet von { $prover }
    .keyword = Zeuge

hours-asking-silence = Epoche { $epoch }: { $why }
    .keyword = Stille
