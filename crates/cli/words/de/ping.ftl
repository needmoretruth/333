### `333 ping`: one heartbeat with another node.

ping-name = { $name }
    .keyword = Name

ping-knocking = { $address }
    .keyword = klopft

ping-writing-who-answered = schreibe auf, wer geantwortet hat
ping-knocking-on = klopfe bei { $address }
ping-unfinished = { $address } nahm die Verbindung an und beendete den Tausch nicht in { $seconds } s
ping-exchanging = tausche Herzschläge
