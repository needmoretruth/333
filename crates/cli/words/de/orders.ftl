### What a typed order that could not be read is told.

orders-nothing-typed = nichts getippt
orders-unknown = hier gibt es kein `{ $word }`. { $words }
orders-wants = das braucht danach { $what }

orders-wants-address = eine Adresse
orders-wants-invitation = eine Einladung
orders-wants-signal = welche der 333
orders-wants-on-or-off = on oder off
orders-wants-bridge-line = eine Brückenzeile
orders-wants-program = einen Programmnamen oder Pfad
orders-wants-status-word = nichts, --all, --sources oder --json
