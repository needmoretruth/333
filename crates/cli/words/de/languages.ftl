### `333 languages`, and what each language calls itself.

# The language's name in itself. Shown in every language's list as it is written here.
languages-name = Deutsch

languages-one = { $tag }  { $name }  { $percent } % übersetzt
    .keyword = Sprache

languages-speaking = { $tag }. `333 language <TAG>` speichert eine andere für alle Befehle.
    .keyword = spricht

languages-saved = { $tag }, ab jetzt für alle Befehle. Ein schon laufender Knoten
    behält seine Sprache bis `333 restart`.
    .keyword = Sprache

languages-english = Englisch, ab jetzt für alle Befehle. Ein schon laufender Knoten
    behält seine Sprache bis `333 restart`.
    .keyword = Sprache

languages-unknown = hier gibt es keine Worte für { $tag }. `333 language` listet die
    vorhandenen Sprachen.

languages-saving = speichere die Sprache in { $path }
