### `333 status` with no flags: where this node can be reached, and the epoch.

status-short-address = { $address }
    .keyword = Adresse

status-short-invite = { $invitation }
    .keyword = Einlad.

status-short-unreachable = noch keine. Er findet eine, während er läuft; `333 invite` sagt mehr.
    .keyword = Adresse

status-short-epoch = { $epoch }, endet { $ends }, in { $left }
    .keyword = Epoche

status-short-epoch-in-line = { $epoch }, { $line }, endet { $ends }, in { $left }
    .keyword = Epoche
