### What choosing the words and the base says, once, at the start.

words-broken = ein Teil von { $file } war nicht lesbar (Zeile { $line }). Was dieser Teil
    sagt, wird auf Englisch gesagt.
    .keyword = Worte

words-unreadable = { $file } war nicht lesbar: { $why }. Was es sagt, wird auf Englisch gesagt.
    .keyword = Worte

words-no-catalog = hier gibt es keine Worte für { $tag }, also wird alles auf Englisch
    gesagt. `333 language` listet die vorhandenen Sprachen.
    .keyword = Sprache

words-counting-in-twelve = in zwölf. { $ten } ist zehn, { $eleven } ist elf, und 10 ist zwölf.
    .keyword = Zählung

words-count-in-unknown = in zehn. THE333_COUNT_IN sagt „{ $value }“, was weder ten noch
    twelve noch twelve-ascii ist.
    .keyword = Zählung
