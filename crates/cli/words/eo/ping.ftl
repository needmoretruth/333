### `333 ping`: one heartbeat with another node.

ping-name = { $name }
    .keyword = nomo

ping-knocking = { $address }
    .keyword = frapas

ping-writing-who-answered = notante, kiu respondis
ping-knocking-on = frapante ĉe { $address }
ping-unfinished = { $address } akceptis la konekton kaj ne finis la interŝanĝon ene de {
    ""}{ $seconds } s
ping-exchanging = interŝanĝante korbatojn
