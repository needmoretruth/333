### `333` with no command: how this node is, and what to type next.

overview-no-node = ankoraŭ neniu en { $home }
    .keyword = nodo

overview-name = { $name }
    .keyword = nomo

overview-next-new = `333 join <invitation>` aliĝas per invito de iu, kiu funkciigas
    333. `333 begin` komencas sola.
    .keyword = sekve

overview-next-stopped = `333 start` funkciigas ĝin fone. `333 run` funkciigas ĝin en ĉi
    tiu terminalo.
    .keyword = sekve

overview-next-running = `333 status` montras, kiel ĝi fartas. `333 stop` haltigas ĝin.
    .keyword = sekve
