### Where this node lives, and whether it still lives here.

# A term (a name that starts with `-`) goes on with a line that has to stay one
# line and is wider than a line of a catalog.
-dwelling-would-be-one = farus unu
-dwelling-anywhere-this = ie ajn, ĉi tio

dwelling-made-at = farita ĉe
dwelling-unpacked-at = malpakita ĉe
dwelling-moved-to = laŭdire movita al
dwelling-found-at = unue malfermita de ĉi tiu kliento ĉe

dwelling-writing = skribante { $file }
dwelling-putting-in-place = metante { $file } en lokon
dwelling-resolving = trovante la veran vojon de { $dir }

dwelling-elsewhere = ĉi tiu nodo estis { $how } { $was },
    kaj ĝi nun estas ĉe { $now }.
    Se la dosierujo estis movita aŭ alinomita, tio estas ĉio. Se ĝi
    estis kopiita kaj la originalo ankoraŭ funkcias, tio estas unu nomo
    en du lokoj, kaj ĉiu kontraŭdiros la registron de la alia. Kiam nur
    unu restos, diru tion ĉi tie: { $settle }
    .keyword = hejmo

dwelling-unread-moment = momento, kiu ne legeblis
dwelling-unread-file = dosiero, kies nomo ne legeblis

dwelling-packed = ĉi tiu nodo estis pakita por translokiĝo ĉe { $at }, en { $into }.
    Ĝi loĝas, kie tiu dosiero estis malpakita. Funkciigi ĝin ĉi tie { -dwelling-would-be-one }
    nomon en du lokoj, do nenio en { $home } agos kiel ĝi.

    Se la translokiĝo estis forlasita kaj tiu dosiero neniam malpakita { -dwelling-anywhere-this }
    remetas ĝin: { $undo }

dwelling-unmarking = forigante la markon, ke ĉi tiu nodo estis pakita
