### What a command says when another 333 already has this node's directory.

elsewhere-the-vigil = la nodo funkcianta en ĉi tiu dosierujo
elsewhere-the-vigil-by-number = la nodo funkcianta en ĉi tiu dosierujo (procezo { $pid })
elsewhere-another = alia 333
elsewhere-another-by-number = alia 333 (procezo { $pid })

elsewhere-done = farita de { $vigil }.
    .keyword = farita

elsewhere-failed = { $vigil } ne faris tion.
    .keyword = fiaskis

elsewhere-finding-its-name = { $who } ankoraŭ trovas
    la nomon de ĉi tiu nodo. Lanĉu ĉi tion denove, kiam ĝi havos unu.
    .keyword = okupita

elsewhere-already-keeping = { $who } jam funkcias ĉi tie, kaj unu dosierujo estas unu
    nodo. Oni povas diri al ĝi aferojn de ĉi tie: `333 say 7`,
    `333 join <invitation>`, `333 tell 'tor on'`, `333 stop`. Dua nodo
    bezonas propran dosierujon, donitan per --data-dir.
    .keyword = okupita

elsewhere-keeping = { $who } funkcias ĉi tie, kaj
    { $why }
    .keyword = okupita

elsewhere-nobody-to-tell = neniu nodo funkcias en ĉi tiu dosierujo, do estas neniu por diri.
    `333 start` aŭ `333 run` lanĉas ĝin, kaj tiam ĉi tio funkcias.
    .keyword = neaŭdita

elsewhere-busy = { $who } havas la dosierujon
    de ĉi tiu nodo kaj ne estas funkcianta nodo, al kiu ĉi tio
    transdoneblas. Nenio ĉi tie estis legita aŭ skribita. Lanĉu ĉi tion
    denove, kiam ĝi finos.
    .keyword = okupita

elsewhere-busy-cannot-be-handed = { $who } havas la dosierujon
    de ĉi tiu nodo. En ĉi tiu sistemo oni ankoraŭ ne povas transdoni ion
    al funkcianta 333 el alia terminalo, do nenio ĉi tie estis legita aŭ
    skribita. Tajpu ĝin en ĝian ekranon post `:`, aŭ haltigu ĝin kaj
    lanĉu ĉi tion denove.
    .keyword = okupita
