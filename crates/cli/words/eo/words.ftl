### What choosing the words and the base says, once, at the start.

words-broken = parto de { $file } ne legeblis (linio { $line }). Kion tiu parto diras, estas
    dirata angle.
    .keyword = vortoj

words-unreadable = { $file } ne legeblis: { $why }. Kion ĝi diras, estas dirata angle.
    .keyword = vortoj

words-no-catalog = ne estas vortoj por { $tag } ĉi tie, do ĉio estas dirata angle.
    `333 language` listigas la lingvojn, kiuj ekzistas.
    .keyword = lingvo

words-counting-in-twelve = en dek du. { $ten } estas dek, { $eleven } estas dek unu, kaj 10 estas
    dek du.
    .keyword = kalkulo

words-count-in-unknown = en dek. THE333_COUNT_IN diras "{ $value }", kiu ne estas ten, twelve aŭ
    twelve-ascii.
    .keyword = kalkulo
