### `333 run`: trading with the other nodes once an epoch, and asking whoever was drawn.

hours-asking-failed-gathering = kolektante tion, kion ĉi tiu nodo povus pludoni: { $why }
    .keyword = fiaskis

hours-asking-quiet = { $address }: { $why }
    .keyword = kvieta

hours-asking-unended = la interŝanĝo ne finiĝis ene de { $time } de ĉi tiu epoko, kaj la
    cetero de la horoj ne atendos ĝin
    .keyword = nefinita

hours-asking-reading-address = legante la adreson de samulo
hours-asking-exchanging-heartbeats = interŝanĝante korbatojn
hours-asking-trading = interŝanĝante deklarojn
hours-asking-putting = starigante la demandon
hours-asking-sealing-presenting = sigelante tion, kion ĉi tiu nodo venis diri
hours-asking-saying-what-for = dirante, por kio ĉi tiu nodo venis
hours-asking-sealing-silence = sigelante tion, kio ne okazis

hours-asking-no-answer = neniu respondo
hours-asking-did-not-answer = { $address } ne respondis
hours-asking-did-not-finish = { $address } ne finis la korbaton
hours-asking-neither = { $address } nek demandis nek malkonektis
hours-asking-within = { $what } ene de la { $seconds } s, kiujn la fenestro permesas
hours-asking-nothing-within = nenio ene de la { $seconds } s, kiujn la fenestro permesas

hours-asking-going = neniu ekstere povas malfermi konekton al ĉi tiu nodo, do ĝi iras al la
    { $drawn } el ni lotitaj demandi ĝin ĉi-epoke. La loto sekvas el la
    epoko kaj la ŝlosiloj, do ĉi tiu nodo scias, kiuj ili estas, sen ke
    oni diru.
    .keyword = iras

hours-asking-unknown-drawn-by = lotita por esti demandata de unu el ni, kies lokon neniu diris
    .keyword = nekonata

hours-asking-unasked = epoko { $epoch }: { $why }
    .keyword = nepetita

hours-asking-drawn = epoko { $epoch } — demandi { $asked } el ni. Neniu elektis tion: la nomoj
    sekvas el la epoko kaj la ŝlosiloj, same sur ĉiu maŝino.
    .keyword = lotita

hours-asking-unknown-drawn-to-ask = lotita por demandi unu el ni, kies lokon neniu diris
    .keyword = nekonata

hours-asking-unheard = epoko { $epoch }: { $why }
    .keyword = neaŭdita

hours-asking-witness = epoko { $epoch } respondita de { $prover }
    .keyword = atesto

hours-asking-silence = epoko { $epoch }: { $why }
    .keyword = silento
