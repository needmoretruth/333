### `333 status` with no flags: where this node can be reached, and the epoch.

status-short-address = { $address }
    .keyword = adreso

status-short-invite = { $invitation }
    .keyword = invito

status-short-unreachable = ankoraŭ neniu. Ĝi trovas unu, dum ĝi funkcias; `333 invite` diras pli.
    .keyword = adreso

status-short-epoch = { $epoch }, finiĝas { $ends }, post { $left }
    .keyword = epoko

status-short-epoch-in-line = { $epoch }, { $line }, finiĝas { $ends }, post { $left }
    .keyword = epoko
