### `333 languages`, and what each language calls itself.

# The language's name in itself. Shown in every language's list as it is written here.
languages-name = Esperanto

languages-one = { $tag }  { $name }  { $percent }% tradukita
    .keyword = lingvo

languages-speaking = { $tag }. `333 language <TAG>` konservas alian por ĉiu komando.
    .keyword = parolas

languages-saved = { $tag }, por ĉiu komando de nun. Nodo, kiu jam funkcias, tenas
    sian lingvon ĝis `333 restart`.
    .keyword = lingvo

languages-english = la angla, por ĉiu komando de nun. Nodo, kiu jam funkcias, tenas
    sian lingvon ĝis `333 restart`.
    .keyword = lingvo

languages-unknown = ne estas vortoj por { $tag } ĉi tie. `333 language` listigas la
    lingvojn, kiuj ekzistas.

languages-saving = konservante la lingvon en { $path }
