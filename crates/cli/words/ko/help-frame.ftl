### 각 명령의 도움말에서 clap이 말 둘레에 붙이는 말.

help-frame-usage = 사용법
help-frame-commands = 명령
help-frame-arguments = 인자
help-frame-options = 옵션
help-frame-default = 기본값
# 한국어는 별칭의 수로 낱말이 바뀌지 않지만, 영어와 같은 것을 받습니다.
help-frame-alias = { $aliases ->
       *[other] 별칭
    }

help-frame-advanced = 고급 옵션

help-frame-more-commands = 그 밖의 명령
