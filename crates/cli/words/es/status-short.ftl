### `333 status` with no flags: where this node can be reached, and the epoch.

status-short-address = { $address }
    .keyword = señas

status-short-invite = { $invitation }
    .keyword = invita

status-short-unreachable = aún ninguna. La encuentra mientras funciona; `333 invite` dice más.
    .keyword = señas

status-short-epoch = { $epoch }, termina { $ends }, dentro de { $left }
    .keyword = época

status-short-epoch-in-line = { $epoch }, { $line }, termina { $ends }, dentro de { $left }
    .keyword = época
