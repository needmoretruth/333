### `333 ping`: one heartbeat with another node.

ping-name = { $name }
    .keyword = nombre

ping-knocking = { $address }
    .keyword = llama

ping-writing-who-answered = anotando quién respondió
ping-knocking-on = llamando a { $address }
ping-unfinished = { $address } aceptó la conexión y no terminó el intercambio en { $seconds } s
ping-exchanging = intercambiando latidos
