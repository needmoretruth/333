### What choosing the words and the base says, once, at the start.

words-broken = no se pudo leer parte de { $file } (línea { $line }). Lo que dice esa parte
    se dice en inglés.
    .keyword = palabras

words-unreadable = no se pudo leer { $file }: { $why }. Lo que dice se dice en inglés.
    .keyword = palabras

words-no-catalog = aquí no hay palabras para { $tag }, así que todo se dice en inglés.
    `333 language` lista los idiomas que hay.
    .keyword = idioma

words-counting-in-twelve = en doce. { $ten } es diez, { $eleven } es once, y 10 es doce.
    .keyword = cuenta

words-count-in-unknown = en diez. THE333_COUNT_IN dice "{ $value }", que no es ten, twelve ni
    twelve-ascii.
    .keyword = cuenta
