### Whether this node is running, and how: the first line of `333` and `333 status`.

running-background-since = en segundo plano desde { $since }, hace { $ago }
    .keyword = marcha

running-background = en segundo plano
    .keyword = marcha

running-terminal-since = en una terminal desde { $since }, hace { $ago }
    .keyword = marcha

running-terminal = en una terminal
    .keyword = marcha

running-not = no. `333 start` lo pone en marcha en segundo plano.
    .keyword = marcha
