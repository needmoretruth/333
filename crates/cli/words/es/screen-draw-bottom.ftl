### The screen's two bottom lines. Each line has a wide form and a narrow one,
### for a terminal under 62 columns.

screen-draw-bottom-never-answered-wide = nadie ha respondido aún a este nodo
screen-draw-bottom-never-answered = nadie ha respondido nunca
screen-draw-bottom-alive-wide = alguien está respondiendo
screen-draw-bottom-alive = alguien responde
screen-draw-bottom-waiting-wide = nadie ha respondido en { $silent } de las { $needed } épocas
    que harían falta para decirlo
screen-draw-bottom-waiting = nadie en { $silent } de { $needed } épocas
screen-draw-bottom-ended = nadie ha respondido desde la época { $since }. { $years ->
        [one] { $years } año
       *[other] { $years } años
    } y { $days ->
        [one] { $days } día
       *[other] { $days } días
    } hasta que desaparezca
screen-draw-bottom-ended-and-gone = nadie ha respondido desde la época { $since }, y el último
    de los años se ha agotado

screen-draw-bottom-say-which = ¿cuál de las 333 dices?
screen-draw-bottom-say-keys = enter para decirla · esc para no decir nada

screen-draw-bottom-leave-wide = detener el nodo
screen-draw-bottom-leave = detener
screen-draw-bottom-say-wide = decir una de las 333
screen-draw-bottom-say = decir
screen-draw-bottom-more-wide = todo lo demás
screen-draw-bottom-more = más
screen-draw-bottom-has-the-file = el archivo está aquí
screen-draw-bottom-not-given = a este nodo no le han dado el archivo
screen-draw-bottom-keys-wide = todas las teclas
screen-draw-bottom-keys = teclas
