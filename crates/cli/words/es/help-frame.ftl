### What clap says around the words of each command's help.

help-frame-usage = Uso
help-frame-commands = Órdenes
help-frame-arguments = Argumentos
help-frame-options = Opciones
help-frame-default = por defecto
help-frame-alias = { $aliases ->
        [one] alias
       *[other] alias
    }

help-frame-advanced = Avanzado

help-frame-more-commands = Más órdenes
