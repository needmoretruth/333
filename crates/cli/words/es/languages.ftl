### `333 languages`, and what each language calls itself.

# The language's name in itself. Shown in every language's list as it is written here.
languages-name = Español

languages-one = { $tag }  { $name }  { $percent }% traducido
    .keyword = idioma

languages-speaking = { $tag }. `333 language <TAG>` guarda otro para todas las órdenes.
    .keyword = habla

languages-saved = { $tag }, para todas las órdenes desde ahora. Un nodo que ya esté
    en marcha conserva su idioma hasta `333 restart`.
    .keyword = idioma

languages-english = inglés, para todas las órdenes desde ahora. Un nodo que ya esté en
    marcha conserva su idioma hasta `333 restart`.
    .keyword = idioma

languages-unknown = aquí no hay palabras para { $tag }. `333 language` lista los
    idiomas que hay.

languages-saving = guardando el idioma en { $path }
